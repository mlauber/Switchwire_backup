#####################################################################
#   X Stepper Settings
#####################################################################

######
# Motor -XM
# Endstop - X-STOP
###############

[stepper_x]
step_pin: P2.2
dir_pin: !P2.6
enable_pin: !P2.1
rotation_distance: 40
full_steps_per_rotation: 200
microsteps: 32
endstop_pin: ^SHT36:gpio22
position_endstop: 250
position_min: 0
position_max: 250
homing_speed: 70
homing_positive_dir: true

[tmc2209 stepper_x]
uart_pin: P1.10
#tx_pin: 
#uart_address: 0
run_current: 0.8
interpolate: False
stealthchop_threshold: 0

#####################################################################
#   Y Stepper Settings
#####################################################################

######
# Motor -YM
# Endstop - Y-STOP
###############
[stepper_y]
step_pin: P0.19
dir_pin: !P0.20
enable_pin: !P2.8
rotation_distance: 40
full_steps_per_rotation: 200
microsteps: 32
## Ucomment one of the following:
## Switch-based endstop for Y
endstop_pin: ^P1.28
## Sensorless endstop for Y
#endstop_pin: tmc2209_stepper_y:virtual_endstop
#homing_retract_dist: 0 # Uncomment this line too
position_endstop: 250
position_min: 0
position_max: 250
homing_speed: 70
homing_positive_dir: true

[tmc2209 stepper_y]
uart_pin: P1.9
#tx_pin: PC10
#uart_address: 2
run_current: 1.1
interpolate: False
stealthchop_threshold: 0
## Uncomment if using sensorless Y homing.
#driver_SGTHRS: 120 # tune this once it's working.

#####################################################################
#   Z Stepper Settings
#####################################################################

######
# Motor -ZAM
# Endstop - Z-STOP
###############
[stepper_z]
step_pin: P0.22
dir_pin: !P2.11
enable_pin: !P0.21
rotation_distance: 40
full_steps_per_rotation: 200
microsteps: 32
endstop_pin: probe:z_virtual_endstop
homing_retract_dist: 0
position_max: 250
homing_speed: 10
position_min: -10.0



[tmc2209 stepper_z]
uart_pin: P1.8
#tx_pin: PC10
#uart_address: 1
run_current: 0.8
interpolate: False
stealthchop_threshold: 0

#####################################################################
#   Extruder Settings
#####################################################################

######
#Motor - EM
###############
[extruder]
step_pin:SHT36:gpio7
dir_pin:SHT36:gpio6
enable_pin: !SHT36:gpio14
microsteps: 16
nozzle_diameter: 0.400
filament_diameter: 1.750
heater_pin:SHT36:gpio23

rotation_distance: 5.7
#rotation_distance: 22.973460    
#gear_ratio: 50:10
full_steps_per_rotation: 200

sensor_pin: SHT36:gpio27
sensor_type: ATC Semitec 104NT-4-R025H42G
min_temp: 10
max_temp: 280
max_power: 1.0
min_extrude_temp: 170
max_extrude_only_distance: 101.0
max_extrude_cross_section: .64

#control = pid
#pid_kp = 26.213
#pid_ki = 1.304
#pid_kd = 131.721

##  Try to keep pressure_advance below 1.0
pressure_advance: 0.07385
##  Default is 0.040, leave stock
pressure_advance_smooth_time: 0.040


[tmc2209 extruder]
uart_pin: SHT36:gpio15
run_current: 0.650
stealthchop_threshold: 999999
interpolate: False


#####################################################################
#   Bed Heater
#####################################################################

######
# BED Connector
###############
[heater_bed]
heater_pin: P2.5
## Check what thermistor type you have. See https://www.klipper3d.org/Config_Reference.html#common-thermistors for common thermistor types.
## Use "Generic 3950" for Keenovo heaters
sensor_type:  NTC 100K MGB18-104F39050L32
sensor_pin: P0.25
min_temp: 0
max_temp: 130
max_power: 0.6
#control: pid
#pid_kp: 58.437
#pid_ki: 2.347
#pid_kd: 363.769

#####################################################################
#   Beacon / Probe 
#####################################################################

[beacon]
serial: /dev/serial/by-id/usb-Beacon_Beacon_RevH_0BDE0CF35154354D38202020FF0A1F14-if00
x_offset: 0 # update with offset from nozzle on your machine
y_offset: 17 # update with offset from nozzle on your machine
mesh_main_direction: x
mesh_runs: 2

contact_max_hotend_temperature: 180 # increase to probe at print temps

home_xy_position: 125, 125 # update for your machine
home_z_hop: 5
home_z_hop_speed: 30
home_xy_move_speed: 300
home_method: contact # use proximity for induction homing
home_method_when_homed: proximity # after initial calibration use induction
home_autocalibrate: unhomed # contact will calibrate beacon on first home
#contact_sensitivity: 2
# Adjusts noise tolerance of contact processing. Values 0-3 are valid, with 3 tolerating the most noise.
#contact_latency_min: 10
# Limits how low of a latency contact is allowed to advance.

#####################################################################
#   INPUT SHAPER     
#####################################################################

[input_shaper]
shaper_freq_x: 49.4
shaper_type_x: mzv
shaper_freq_y: 48.0
shaper_type_y: 3hump_ei


#####################################################################
#   Fan Control
#####################################################################

######
# Electronics Fan
# Z-PROBE Connector
###############
[controller_fan Electronics_Fan]
pin: P2.3 
kick_start_time: 0.100
heater: heater_bed
#max_power: 
#fan_speed: 


######
# Hot End Fan
# FAN1 Connector
###############
[heater_fan hotend_fan]
pin: SHT36:gpio21
heater: extruder
heater_temp: 50.0
##  If you are experiencing back flow, you can reduce fan_speed
#fan_speed: 1.0

######
# Part Cooling Fan
# FAN0 Connector
###############
[fan]
pin: SHT36:gpio13  # "FAN0"
#cycle_time: .08
##  Depending on your fan, you may need to increase this value
##  if your fan will not start. Can change cycle_time (increase)
##  if your fan is not able to slow down effectively
#kick_start_time: .25

#####################################################################
#   Homing and Bed Mesh
#####################################################################


[bed_mesh]
speed: 150
horizontal_move_z: 5
mesh_min: 25,35.0
mesh_max: 225.0,220
probe_count: 5,5
algorithm: bicubic
fade_start: 3
fade_end: 10
fade_target: 0

#####################################################################
#   Displays
#####################################################################
##  For the mini12864 Display, the [display] and [neopixel] must be uncommented

[virtual_sdcard]
path: ~/printer_data/gcodes
[display_status]
[pause_resume]

[display]
lcd_type: uc1701
cs_pin: EXP1_3
a0_pin: EXP1_4
rst_pin: EXP1_5
contrast: 63
encoder_pins: ^EXP2_5, ^EXP2_3
click_pin: ^!EXP1_2

[output_pin beeper]
pin: EXP1_1

########################################
# EXP1 / EXP2 (display) pins
########################################

[board_pins]
aliases:
    # EXP1 header
    EXP1_1=P1.30, EXP1_3=P1.18, EXP1_5=P1.20, EXP1_7=P1.22, EXP1_9=<GND>,
    EXP1_2=P0.28, EXP1_4=P1.19, EXP1_6=P1.21, EXP1_8=P1.23, EXP1_10=<5V>,
    # EXP2 header
    EXP2_1=P0.17, EXP2_3=P3.26, EXP2_5=P3.25, EXP2_7=P1.31, EXP2_9=<GND>,
    EXP2_2=P0.15, EXP2_4=P0.16, EXP2_6=P0.18, EXP2_8=<RST>, EXP2_10=<NC>
    # Pins EXP2_1, EXP2_6, EXP2_2 are also MISO, MOSI, SCK of bus "ssp0"


#####################################################################
#   Case Lights
#####################################################################
[output_pin LIGHTS]
pin: P2.7
#pwm: true
#hardware_pwm: true
value: 1
shutdown_value: 0

[gcode_macro lights_on]
gcode:
    SET_PIN PIN=LIGHTS VALUE=1.0

[gcode_macro lights_off]
gcode:
    SET_PIN PIN=LIGHTS VALUE=0.0


############################################################################################
#   Macros
############################################################################################

[include Idle_Timeout.cfg]

[exclude_object]


[gcode_macro PRINT_START]
gcode:
    # 1. Fetch temperatures passed from Orca Slicer
    {% set BED_TEMP = params.BED|default(60)|float %}
    {% set HOTEND_TEMP = params.EXTRUDER|default(210)|float %}

    # 2. Start heating the bed, keep nozzle safe and cold for the Beacon sensor
    M104 S150 ; Non-oozing temp to protect bed & Beacon
    M190 S{BED_TEMP} ; Wait for bed to reach full temperature

    # 3. Kinematics (Homing)
    G90 ; Absolute positioning
    G28 ; Home all axes (Uses Beacon proximity)

    # 4. Bed Meshing with Beacon
    BED_MESH_CALIBRATE ; Fast Beacon mesh right before printing

    # 5. Move to Blobifier bucket and final heat
    # This prevents the nozzle from oozing onto your clean build plate
    BLOBIFIER_PARK ; Move toolhead to Blobifier tray/bucket
    M109 S{HOTEND_TEMP} ; Wait for nozzle to reach full printing temp

    # 6. Clear extruder position before Happy Hare takes over back in the Slicer
    G92 E0 ; Reset extruder distance


[gcode_macro PRINT_END]
# Use PRINT_END for the slicer ending script
gcode:
    # Safe anti-stringing move coords
    {% set th = printer.toolhead %}
    {% set x_safe = th.position.x + 20 * (1 if th.axis_maximum.x - th.position.x > 20 else -1) %}
    {% set y_safe = th.position.y + 20 * (1 if th.axis_maximum.y - th.position.y > 20 else -1) %}
    {% set z_safe = [th.position.z + 2, th.axis_maximum.z]|min %}

    SAVE_GCODE_STATE NAME=STATE_PRINT_END
    M400                          ; Wait for buffer to clear
    G92 E0                        ; Zero the extruder

    # --- HAPPY HARE INTEGRATION ---
    MMU_END                       ; Retracts filament safely to the MMU while nozzle is hot

    CLEAN_NOZZLE                  ; Initial nozzle scrub
    TURN_OFF_HEATERS              ; Shut down heaters after MMU and scrubbing
    CLEAN_NOZZLE                  ; Final brush while cooling down

    G90                           ; Absolute positioning
    G0 X{x_safe} Y{y_safe} Z{z_safe} F20000 ; Quick move to snap any remaining wisps
    G0 X{th.axis_maximum.x//2} Y{th.axis_maximum.y - 2} F3600 ; Park nozzle centered at rear
    
    M107                          ; Turn off fan
    #SET_PIN PIN=nevermore VALUE=0
    BED_MESH_CLEAR                ; Clear your Beacon mesh profile
    RESTORE_GCODE_STATE NAME=STATE_PRINT_END



